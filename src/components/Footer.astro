---
import { mainNav, extrasNav } from '../lib/nav';
import { url } from '../lib/url';
import siteConfig from '../../site.config.json';
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__title">🦍 {siteConfig.branding.title}</p>
      <p class="site-footer__sub">{siteConfig.branding.subtitle}</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        {mainNav.map((item) => (
          <li><a href={url(item.href)}>{item.label}</a></li>
        ))}
      </ul>
      <ul>
        {extrasNav.map((item) => (
          <li><a href={url(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="container site-footer__legal">
    <p>Made with love (and far too much coffee) for {siteConfig.branding.host}'s defense.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--forest-900);
    color: var(--cream-200);
    padding-block: clamp(2rem, 5vw, 3.5rem) 1.5rem;
    margin-top: auto;
  }
  .site-footer__inner {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 720px) {
    .site-footer__inner { grid-template-columns: 1fr 2fr; align-items: start; }
  }
  .site-footer__title { font-family: var(--font-display); font-size: 1.3rem; color: var(--cream-50); margin: 0 0 0.25rem; }
  .site-footer__sub { margin: 0; font-size: 0.95rem; }
  .site-footer__nav { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .site-footer__nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .site-footer__nav a { color: var(--cream-200); text-decoration: none; font-size: 0.95rem; }
  .site-footer__nav a:hover { color: var(--gold-soft); }
  .site-footer__legal { margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,0.1); }
  .site-footer__legal p { margin: 0; font-size: 0.85rem; color: var(--forest-300); }
</style>
