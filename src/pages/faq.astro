---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../lib/url';
import faq from '../data/faq.json';
import siteConfig from '../../site.config.json';

const donation = siteConfig.donation;
---

<Layout title="FAQ" description="Answers to the questions guests ask most.">
  <PageHeader eyebrow="Saving dozens of WhatsApp messages" title="FAQ" />

  <section class="section">
    <div class="container faq-wrap">
      {faq.items.map((item) => (
        <details class="faq-item">
          <summary>{item.q}</summary>
          <div class="faq-item__body">
            <p>{item.a}</p>
            {item.donation && (
              <p>
                {donation.url
                  ? <a class="btn btn--gold" href={donation.url} target="_blank" rel="noopener">Donate to {donation.label} ↗</a>
                  : <span class="tbc">donation link TBC</span>}
              </p>
            )}
            {item.travelLink && (
              <p><a class="btn btn--ghost" href={url('/travel')}>Go to Travel →</a></p>
            )}
          </div>
        </details>
      ))}
    </div>
  </section>
</Layout>

<style>
  .faq-wrap { max-width: 760px; }
  .faq-item {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    margin-bottom: 0.8rem;
    overflow: hidden;
  }
  .faq-item summary {
    cursor: pointer;
    padding: 1.1rem 1.3rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--forest-800);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; font-size: 1.5rem; color: var(--gold); transition: transform 0.2s ease; }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item__body { padding: 0 1.3rem 1.2rem; }
  .faq-item__body p:last-child { margin-bottom: 0; }
</style>
