---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import siteConfig from '../../site.config.json';

// Three states, in priority order:
//   1. rsvp.endpoint set   → the built-in form below posts straight to it (Formspree)
//   2. rsvp.formEmbedUrl   → embed an external form (Google Forms) instead
//   3. neither             → a friendly "not open yet" note for guests
const { endpoint, formEmbedUrl, formUrl } = siteConfig.rsvp as {
  endpoint?: string;
  formEmbedUrl?: string;
  formUrl?: string;
};

const parts = [
  'Thursday arrival drinks',
  'Friday — the defense',
  'Friday — the party tram',
  'Friday — dinner & the night out',
  'Saturday–Sunday — reservoir weekend',
];
const arrivalDays = ['Thursday', 'Friday', 'Earlier in the week', 'Not sure yet'];
const departureDays = ['Saturday', 'Sunday', 'Monday', 'Later', 'Not sure yet'];
const routes = ['Direct to Brno', 'Via Vienna', 'Via Bratislava', 'Via Prague', 'Driving', 'Not sure yet'];
const accommodation = [
  'Booked already',
  "I'd like a recommendation",
  'Hoping for a spot at the reservoir house',
  'Not sorted yet',
];
---

<Layout title="RSVP" description="Let Kelly know if you can make it.">
  <PageHeader
    eyebrow="Yes, you"
    title="RSVP"
    lead="One quick form. It helps Kelly plan everything from the tram to the reservoir beds."
  />

  <section class="section">
    <div class="container rsvp-wrap">
      {endpoint ? (
        <form class="rsvp-form" action={endpoint} method="POST">
          <input type="hidden" name="_subject" value="Going Ape Shit — new RSVP" />

          <div class="field">
            <label for="name">Full name <span class="req" aria-hidden="true">*</span></label>
            <input id="name" name="name" type="text" required autocomplete="name" />
          </div>

          <div class="field">
            <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" required autocomplete="email" />
          </div>

          <div class="field">
            <label for="phone">Mobile <span class="hint">(with country code)</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="+31 6 12345678" />
          </div>

          <fieldset class="field">
            <legend>Can you make it? <span class="req" aria-hidden="true">*</span></legend>
            <label class="choice"><input type="radio" name="attending" value="Yes" required /> <span>Yes — wouldn't miss it</span></label>
            <label class="choice"><input type="radio" name="attending" value="Can't make it" /> <span>Sadly can't make it</span></label>
            <label class="choice"><input type="radio" name="attending" value="Not sure yet" /> <span>Not sure yet</span></label>
          </fieldset>

          <fieldset class="field">
            <legend>Which bits will you join?</legend>
            {parts.map((p) => (
              <label class="choice"><input type="checkbox" name="joining" value={p} /> <span>{p}</span></label>
            ))}
          </fieldset>

          <div class="field-row">
            <div class="field">
              <label for="arrival">Arriving</label>
              <select id="arrival" name="arrival">
                <option value="">—</option>
                {arrivalDays.map((d) => <option value={d}>{d}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="departure">Leaving</label>
              <select id="departure" name="departure">
                <option value="">—</option>
                {departureDays.map((d) => <option value={d}>{d}</option>)}
              </select>
            </div>
          </div>

          <div class="field">
            <label for="route">How are you getting here?</label>
            <select id="route" name="route">
              <option value="">—</option>
              {routes.map((r) => <option value={r}>{r}</option>)}
            </select>
          </div>

          <div class="field">
            <label for="accommodation">Accommodation</label>
            <select id="accommodation" name="accommodation">
              <option value="">—</option>
              {accommodation.map((a) => <option value={a}>{a}</option>)}
            </select>
          </div>

          <div class="field">
            <label for="guests">Bringing anyone? <span class="hint">(partners and children are very welcome)</span></label>
            <input id="guests" name="guests" type="text" placeholder="Just me / +1 / two kids aged 4 and 7" />
          </div>

          <div class="field">
            <label for="dietary">Dietary requirements or allergies</label>
            <input id="dietary" name="dietary" type="text" />
          </div>

          <div class="field">
            <label for="song">A song for the tram <span class="hint">(optional, but encouraged)</span></label>
            <input id="song" name="song" type="text" />
          </div>

          <div class="field">
            <label for="message">Anything else?</label>
            <textarea id="message" name="message" rows="4"></textarea>
          </div>

          <button class="btn btn--gold rsvp-submit" type="submit">Send my RSVP</button>
          <p class="muted rsvp-foot">Required fields are marked <span class="req">*</span>. Everything else is optional.</p>
        </form>
      ) : formEmbedUrl ? (
        <div class="rsvp-frame">
          <iframe
            src={formEmbedUrl}
            title="RSVP form"
            width="100%"
            height="1400"
            frameborder="0"
            marginheight="0"
            marginwidth="0"
            loading="lazy"
          >Loading…</iframe>
        </div>
      ) : (
        <div class="callout rsvp-placeholder">
          <h3>RSVPs open soon</h3>
          <p>The form isn't live just yet — check back shortly, or just message Kelly directly in the meantime.</p>
        </div>
      )}

      {formEmbedUrl && formUrl && !endpoint && (
        <p class="muted center" style="margin-top:1rem">
          Form not loading? <a href={formUrl} target="_blank" rel="noopener">Open it in a new tab ↗</a>
        </p>
      )}
    </div>
  </section>
</Layout>

<style>
  .rsvp-wrap { max-width: 720px; }
  .rsvp-frame { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .rsvp-frame iframe { display: block; width: 100%; }

  .rsvp-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .field { display: flex; flex-direction: column; gap: 0.4rem; border: 0; padding: 0; margin: 0; }
  .field-row { display: grid; gap: 1.25rem; }
  @media (min-width: 560px) { .field-row { grid-template-columns: 1fr 1fr; } }

  label, legend { font-weight: 700; color: var(--forest-800); font-size: 0.95rem; padding: 0; }
  .hint { font-weight: 400; color: var(--ink-soft); font-size: 0.85rem; }
  .req { color: var(--gold); }

  input[type='text'], input[type='email'], input[type='tel'], select, textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    width: 100%;
  }
  textarea { resize: vertical; }
  input:focus-visible, select:focus-visible, textarea:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 1px;
  }

  .choice { display: flex; align-items: center; gap: 0.55rem; font-weight: 400; }
  .choice input { width: 1.05rem; height: 1.05rem; accent-color: var(--forest-600); flex: none; }

  .rsvp-submit { align-self: flex-start; margin-top: 0.25rem; }
  .rsvp-foot { font-size: 0.85rem; }
  .rsvp-placeholder { text-align: center; }
</style>
