---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import travel from '../data/travel.json';
---

<Layout title="Travel" description="Brno in, Vienna out — every route to the celebration.">
  <PageHeader eyebrow="Getting there" title="Travel" lead={travel.lead} />

  <section class="section">
    <div class="container">
      <p class="lead">Compare your options, then mix and match — you don't have to come and go the same way.</p>

      <div class="table-wrap" style="margin-top:1.5rem">
        <table>
          <thead>
            <tr>
              <th>Gateway</th>
              <th>Fly from the UK</th>
              <th>Then to Brno</th>
              <th>Rough total</th>
              <th>Best for</th>
            </tr>
          </thead>
          <tbody>
            {travel.gateways.map((g) => (
              <tr>
                <td>
                  <strong>{g.name}</strong>
                  {g.tag && <span class={`pill ${g.highlight ? '' : 'pill--soft'}`}>{g.tag}</span>}
                </td>
                <td>{g.flyFromUK}</td>
                <td>{g.thenToBrno}</td>
                <td>{g.roughTotal}</td>
                <td>{g.bestFor}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Mix & match callout -->
      <div class="callout mixmatch">
        <h3>{travel.mixAndMatch.title}</h3>
        <p>{travel.mixAndMatch.intro}</p>
        <ul>
          {travel.mixAndMatch.points.map((p) => <li>{p}</li>)}
        </ul>
        <p class="mixmatch__rule">{travel.mixAndMatch.rule}</p>
      </div>

      <!-- Ground booking -->
      <div class="card ground">
        <p><strong>{travel.groundBooking.note}</strong></p>
        <a class="btn btn--primary" href={travel.groundBooking.url} target="_blank" rel="noopener">
          Book ground travel — {travel.groundBooking.name} ↗
        </a>
      </div>

      <!-- Route maps -->
      <h2 style="margin-top:2.5rem">Airport → Brno routes</h2>
      <div class="grid grid--2 route-maps">
        {travel.gateways.map((g) => (
          <div class="card route-map">
            <h3>{g.name}</h3>
            <a class="btn btn--ghost" href={`https://www.google.com/maps/search/?api=1&query=${g.mapsQuery}`} target="_blank" rel="noopener">
              Open route in Google Maps ↗
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .pill--soft { background: var(--cream-200); color: var(--forest-700); }
  td .pill { margin-left: 0.4rem; }
  .mixmatch { margin-top: 2rem; }
  .mixmatch ul { margin: 0.5rem 0 1rem; padding-left: 1.2rem; }
  .mixmatch li { margin-bottom: 0.5rem; }
  .mixmatch__rule { font-family: var(--font-display); font-size: 1.3rem; color: var(--gold-soft); margin: 0; }
  .ground { margin-top: 2rem; display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; }
  .route-maps { margin-top: 1rem; }
  .route-map h3 { margin-bottom: 0.75rem; }
</style>
