---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Figure from '../components/Figure.astro';
import data from '../data/thingstodo.json';

function hostname(u: string) {
  try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; }
}
---

<Layout title="Things To Do" description="Brno's sights and Kelly's personal local guide.">
  <PageHeader eyebrow="Brno + Kelly's local guide" title="Things To Do" lead={data.intro} />

  <section class="section">
    <div class="container">
      <!-- Kelly's Picks -->
      <div class="picks">
        <h2>{data.kellysPicks.title}</h2>
        <p class="lead">{data.kellysPicks.blurb}</p>
        <div class="grid grid--3">
          {data.kellysPicks.places.map((p) => (
            <div class="card card--accent pick">
              {'image' in p && p.image && (
                <div class="pick__media">
                  <Figure src={p.image} alt={p.name} label={p.name} ratio="4 / 3" />
                </div>
              )}
              <h3>{p.name}</h3>
              <p class="muted">{p.blurb}</p>
              {p.url && <a class="pick__link" href={p.url} target="_blank" rel="noopener">{hostname(p.url)} ↗</a>}
            </div>
          ))}
        </div>
      </div>

      <!-- Must-see + Nature -->
      <div class="grid grid--2" style="margin-top:2.5rem">
        <div class="card">
          <h3>{data.mustSee.title}</h3>
          <ul class="taglist">{data.mustSee.items.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div class="card">
          <h3>{data.nature.title}</h3>
          <ul class="taglist">{data.nature.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      </div>

      <!-- More spots -->
      <h2 style="margin-top:2.5rem">{data.moreSpots.title}</h2>
      <p class="muted">{data.moreSpots.blurb}</p>
      <div class="grid grid--3">
        {data.moreSpots.categories.map((cat) => (
          <div class="card">
            <h3>{cat.title}</h3>
            <ul class="spotlist">
              {cat.places.map((p) => (
                <li><strong>{p.name}</strong> — <span class="muted">{p.blurb}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .picks h2 { color: var(--gold); }
  .pick { display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-start; }
  .pick__media { width: 100%; margin-bottom: 0.3rem; }
  .pick__link { margin-top: auto; font-weight: 700; }
  .taglist { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 0.5rem 0 0; }
  .taglist li { background: var(--cream-100); border: 1px solid var(--line); border-radius: 999px; padding: 0.3rem 0.8rem; font-size: 0.9rem; }
  .spotlist { padding-left: 1.1rem; margin: 0.5rem 0 0; }
  .spotlist li { margin-bottom: 0.6rem; }
</style>
