---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import siteConfig from '../../site.config.json';

// RSVP has three possible modes, set by site.config.json -> rsvp.method:
//   'whatsapp' (default) — guests copy a ready-made message into their own chat.
//                          Kelly's number is NOT published unless whatsappNumber is set.
//   'form'              — the built-in form, posting to rsvp.endpoint (Formspree).
//   'embed'             — an external form (Google Forms) via rsvp.formEmbedUrl.
const rsvp = siteConfig.rsvp as {
  method?: string;
  whatsappNumber?: string;
  endpoint?: string;
  formEmbedUrl?: string;
  formUrl?: string;
};
const method = rsvp.method ?? 'whatsapp';
const waNumber = (rsvp.whatsappNumber ?? '').replace(/[^0-9]/g, '');

const template = `Hi Kelly! RSVP for Going Ape Shit 🦍

Name:
Coming? (yes / no / not sure):
Which bits: (Thursday drinks / the defense / party tram / dinner & night out / reservoir weekend)
Arriving:
Leaving:
Bringing anyone:
Dietary needs / allergies:
Song for the tram:
Anything else:`;

const waLink = waNumber
  ? `https://wa.me/${waNumber}?text=${encodeURIComponent(template)}`
  : '';

const asks = [
  'Your name',
  'Whether you can make it',
  'Which bits you want to join',
  'When you arrive and leave',
  'Anyone you’re bringing — partners and children very welcome',
  'Dietary needs or allergies',
  'A song for the tram',
];
---

<Layout title="RSVP" description="RSVP by WhatsApp — just message Kelly.">
  <PageHeader
    eyebrow="Yes, you"
    title="RSVP"
    lead="No forms, no logins. Just WhatsApp Kelly — you already have her number."
  />

  <section class="section">
    <div class="container rsvp-wrap">
      {method === 'whatsapp' ? (
        <>
          <div class="card rsvp-card">
            <h2>What to tell me</h2>
            <ul class="asks">
              {asks.map((a) => <li>{a}</li>)}
            </ul>
            <p class="muted">
              Nothing formal — a one-line “yes, all of it” is a perfectly good RSVP. The details just help
              with planning the tram, the dinner table and the reservoir beds.
            </p>
          </div>

          <div class="card rsvp-card">
            <h2>Copy &amp; paste</h2>
            <p class="muted">Tap copy, open our chat, paste, fill it in. That’s the whole thing.</p>
            <pre class="template" id="rsvp-template">{template}</pre>
            <div class="rsvp-actions">
              <button class="btn btn--gold" type="button" id="copy-btn" data-label="Copy the message">Copy the message</button>
              {waLink && (
                <a class="btn btn--ghost" href={waLink} target="_blank" rel="noopener">Open WhatsApp ↗</a>
              )}
            </div>
          </div>

          <p class="muted center rsvp-foot">
            Not on WhatsApp? A text, an email or a shout across a corridor all work just as well.
          </p>
        </>
      ) : method === 'embed' && rsvp.formEmbedUrl ? (
        <div class="rsvp-frame">
          <iframe
            src={rsvp.formEmbedUrl}
            title="RSVP form"
            width="100%"
            height="1400"
            frameborder="0"
            marginheight="0"
            marginwidth="0"
            loading="lazy"
          >Loading…</iframe>
        </div>
      ) : (
        <div class="callout rsvp-placeholder">
          <h3>RSVPs open soon</h3>
          <p>The form isn’t live just yet — check back shortly, or just message Kelly directly in the meantime.</p>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .rsvp-wrap { max-width: 720px; display: flex; flex-direction: column; gap: 1.25rem; }
  .rsvp-card h2 { margin-top: 0; }
  .asks { margin: 0 0 1rem; padding-left: 1.2rem; }
  .asks li { margin-bottom: 0.35rem; }
  .template {
    background: rgba(0, 0, 0, 0.05);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.9rem 1rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85rem;
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-x: auto;
    margin: 0 0 1rem;
  }
  .rsvp-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .rsvp-foot { font-size: 0.9rem; }
  .rsvp-frame { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .rsvp-frame iframe { display: block; width: 100%; }
  .rsvp-placeholder { text-align: center; }
</style>

<script>
  const btn = document.getElementById('copy-btn');
  const tpl = document.getElementById('rsvp-template');
  if (btn && tpl) {
    btn.addEventListener('click', async () => {
      const text = tpl.textContent ?? '';
      let ok = false;
      try {
        await navigator.clipboard.writeText(text);
        ok = true;
      } catch {
        // Clipboard API needs a secure context and permission. Fall back to
        // selecting the text so the guest can copy it by hand.
        const range = document.createRange();
        range.selectNodeContents(tpl);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
      btn.textContent = ok ? 'Copied ✓' : 'Select all & copy';
      setTimeout(() => {
        btn.textContent = btn.dataset.label ?? 'Copy the message';
      }, 2500);
    });
  }
</script>
